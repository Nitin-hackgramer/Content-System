# Server-side only. Never prefix with NEXT_PUBLIC_.
# Same Supabase project as the Content Discovery pipeline (secret key, not anon).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional, local only: path to the discovery folder. Enables run logs (history, sources)
# and the "Run discovery" / "Write brief" actions, which call the existing Python code.
DISCOVERY_DIR=../content discovery & idea

# Passcode that unlocks Asset Studio changes on a device (server-only, long and random). Unset = Asset Studio is read-only.
STUDIO_KEY=
